# Every variable app.config.ts reads. Copy to .env for local builds;
# on EAS set them with `eas env:create` (plain text, sensitive or file).

# development | staging | production (default: development). Set by eas.json profiles.
APP_ENV=development

# Optional overrides for brand/env.ts (e.g. pointing a dev build at a local server).
API_HOST=
SOCKET_URL=
CLIENT_TOKEN=

# Google Maps SDK keys (EAS: sensitive).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Firebase config file paths (EAS: "file" env vars). Locally you can instead
# drop the files into brand/firebase/ (gitignored).
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=
