# Every variable app.config.ts reads. Copy to .env for local builds;
# on EAS set them with `eas env:create` (plain text, sensitive or file).

# development | staging | production (default: development, the test backend).
# Keep development here so a fresh copy never points at production by accident.
# Switching:
#   - staging: APP_ENV=staging in your local .env (same test backend, staging app id).
#   - production: never through this file. Build with the EAS profile
#     (`eas build --profile production`, which sets APP_ENV=production in eas.json), or
#     for a one-off local run: `APP_ENV=production npx expo start`.
APP_ENV=development

# Optional overrides for brand/env.ts (e.g. pointing a dev build at a local server).
API_HOST=
SOCKET_URL=
CLIENT_TOKEN=

# Google Maps SDK keys (EAS: sensitive).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Firebase config file paths (EAS: "file" env vars). Locally you can instead
# drop the files into brand/firebase/ (gitignored).
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=
